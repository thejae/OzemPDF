{
  "name": "ozempdf",
  "productName": "OzemPDF",
  "version": "0.3.5",
  "private": true,
  "description": "OzemPDF desktop shell — surgical lossless PDF slimming",
  "main": "main.js",
  "author": "OzemPDF",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win zip"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.ozempdf.app",
    "productName": "OzemPDF",
    "directories": {
      "output": "../release",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../artifacts/dist/engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "launchers/Start OzemPDF (compatibility).cmd",
        "to": "Start OzemPDF (compatibility).cmd"
      },
      {
        "from": "launchers/Start OzemPDF in browser.cmd",
        "to": "Start OzemPDF in browser.cmd"
      }
    ],
    "win": {
      "target": [
        "zip"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "assets/icon.png"
    }
  },
  "allowScripts": {
    "electron@38.0.0": true
  }
}
